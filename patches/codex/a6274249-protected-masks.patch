-fn append_unreadable_root_args(
-    bwrap_args: &mut BwrapArgs,
+// Only coalesce below an existing denied directory without any writable
+// descendants. A reopened child, even below another denial, can expose synthetic
+// intermediate directories; retaining those masks is necessary. Both logical and
+// canonical write roots are included by the caller. Logical policy entries stay
+// unchanged; this only avoids mounting children into an already frozen empty view.
+fn coalesce_unreadable_directory_mounts(
+    unreadable_roots: &[PathBuf],
+    allowed_write_paths: &[PathBuf],
+) -> Vec<PathBuf> {
+    unreadable_roots
+        .iter()
+        .filter(|path| {
+            !unreadable_roots.iter().any(|parent| {
+                parent != *path
+                    && path.starts_with(parent)
+                    && parent.is_dir()
+                    && !allowed_write_paths
+                        .iter()
+                        .any(|root| root.starts_with(parent))
+            })
+        })
+        .cloned()
+        .collect()
+}
