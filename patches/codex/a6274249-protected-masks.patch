+        let policy = mask_collision_policy(vec![
+            (workspace.clone(), FileSystemAccessMode::Write),
+            (home.clone(), FileSystemAccessMode::Deny),
+            (auth.clone(), FileSystemAccessMode::Deny),
+            (session.clone(), FileSystemAccessMode::Deny),
