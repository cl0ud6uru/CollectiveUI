+                fs::create_dir(&metadata).expect("metadata");
+            }
+            if state == "populated" {
+                fs::write(metadata.join("sentinel"), "not a credential").expect("sentinel");
+            }
+            let policy = mask_collision_policy(vec![
+                (workspace.clone(), FileSystemAccessMode::Write),
+                (metadata.clone(), FileSystemAccessMode::Deny),
+            ]);
