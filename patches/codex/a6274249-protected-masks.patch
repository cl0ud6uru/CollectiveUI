+    #[test]
+    fn mask_collision_explicit_metadata_deny_has_one_physical_mask() {
+        for state in ["missing", "empty", "populated"] {
+            let temp_dir = TempDir::new().expect("temp dir");
+            let workspace = temp_dir.path().join("workspace");
+            let metadata = workspace.join(".codex");
+            fs::create_dir(&workspace).expect("workspace");
+            if state != "missing" {
+                fs::create_dir(&metadata).expect("metadata");
+            }
+            if state == "populated" {
+                fs::write(metadata.join("sentinel"), "not a credential").expect("sentinel");
+            }
+            let policy = mask_collision_policy(vec![
+                (workspace.clone(), FileSystemAccessMode::Write),
+                (metadata.clone(), FileSystemAccessMode::Deny),
+            ]);
+            let args = create_filesystem_args(&policy, &workspace, BwrapOptions::default())
+                .expect("plan denied metadata");
+            let path = path_to_string(&metadata);
+            let mounts = args
+                .args
+                .windows(2)
+                .filter(|window| window == &["--tmpfs", path.as_str()])
+                .count();
+            let files = args
+                .args
+                .windows(3)
+                .filter(|window| window[0] == "--ro-bind-data" && window[2] == path)
+                .count();
+            assert_eq!(mounts + files, 1, "exactly one mask for {state}");
+            assert!(!policy.can_read_local_path_with_cwd(&metadata, &workspace));
+            if state == "missing" {
+                assert_eq!(files, 1);
+                assert!(!metadata.exists(), "planning must not create metadata");
+                assert!(protected_create_target_paths(&args).contains(&metadata));
+                assert!(synthetic_mount_target_paths(&args).contains(&metadata));
+            } else {
+                assert_eq!(mounts, 1);
+                assert!(
+                    args.args
+                        .windows(4)
+                        .any(|window| { window == &["--perms", "000", "--tmpfs", path.as_str()] })
+                );
+            }
+        }
+    }
