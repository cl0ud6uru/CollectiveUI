+                .expect("plan denied metadata");
+            let path = path_to_string(&metadata);
+            let mounts = args
+                .args
+                .windows(2)
+                .filter(|window| window == &["--tmpfs", path.as_str()])
+                .count();
+            let files = args
+                .args
+                .windows(3)
+                .filter(|window| window[0] == "--ro-bind-data" && window[2] == path)
+                .count();
+            assert_eq!(mounts + files, 1, "exactly one mask for {state}");
+            assert!(!policy.can_read_local_path_with_cwd(&metadata, &workspace));
+            if state == "missing" {
