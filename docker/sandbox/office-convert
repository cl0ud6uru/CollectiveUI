#!/opt/office/bin/python
"""Office export/recalculation with a separate LibreOffice profile per invocation."""
import argparse
import json
from pathlib import Path
import subprocess
import sys
import tempfile

ROOT = Path("/home/agent/workspace").resolve()
MAX_BYTES = 10 * 1024 * 1024


def confined(value):
    path = Path(value).resolve()
    if not path.is_relative_to(ROOT):
        raise ValueError("Input and output paths must be inside your workspace.")
    return path


def validate_office(source):
    try:
        if source.suffix.lower() == ".docx":
            from docx import Document
            Document(source)
        elif source.suffix.lower() == ".xlsx":
            from openpyxl import load_workbook
            book = load_workbook(source, read_only=True, keep_links=False)
            book.close()
        elif source.suffix.lower() == ".pptx":
            from pptx import Presentation
            Presentation(source)
        else:
            source.read_text(encoding="utf-8-sig")
    except Exception:
        raise ValueError("Input could not be read as a valid Office/UTF-8 CSV file. Check whether it is corrupt or password-protected.") from None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("input")
    parser.add_argument("--to", choices=("pdf", "xlsx"), required=True)
    parser.add_argument("--outdir", required=True)
    parser.add_argument("--timeout", type=int, default=90)
    args = parser.parse_args()
    source = confined(args.input)
    outdir = confined(args.outdir)
    if not source.is_file() or source.suffix.lower() not in (".docx", ".xlsx", ".pptx", ".csv"):
        raise ValueError("Choose an existing .docx, .xlsx, .pptx, or .csv file.")
    if source.stat().st_size > MAX_BYTES:
        raise ValueError("Office inputs are limited to 10 MB. Reduce or split the input.")
    validate_office(source)
    if args.to == "xlsx" and source.suffix.lower() not in (".xlsx", ".csv"):
        raise ValueError("Only Excel or CSV inputs can be recalculated/exported as .xlsx.")
    if not 1 <= args.timeout <= 90:
        raise ValueError("Conversion timeout must be between 1 and 90 seconds.")
    if outdir.is_relative_to(ROOT / "uploads"):
        raise ValueError("Write finished copies outside uploads/ to preserve originals.")
    target = outdir / (source.stem + "." + args.to)
    if target == source or target.exists():
        raise ValueError("Choose a fresh output directory; existing files will not be overwritten.")
    outdir.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="office-profile-") as profile:
        # Highest macro security; never enable document macros for file conversion.
        Path(profile, "user").mkdir()
        Path(profile, "user", "registrymodifications.xcu").write_text(
            '<?xml version="1.0"?><oor:items xmlns:oor="http://openoffice.org/2001/registry">'
            '<item oor:path="/org.openoffice.Office.Common/Security/Scripting">'
            '<prop oor:name="MacroSecurityLevel" oor:op="fuse"><value>3</value></prop></item>'
            '</oor:items>', encoding="utf-8")
        filter_name = "xlsx:Calc MS Excel 2007 XML" if args.to == "xlsx" else "pdf"
        subprocess.run(["libreoffice", "-env:UserInstallation=" + Path(profile).as_uri(),
                        "--headless", "--nologo", "--nodefault", "--norestore",
                        "--convert-to", filter_name, "--outdir", str(outdir), str(source)],
                       capture_output=True, timeout=args.timeout, check=True)
    # LibreOffice sometimes reports success without producing a usable output.
    if not target.is_file() or not target.stat().st_size:
        raise ValueError("Conversion produced no file. Check whether the input is corrupt, encrypted, or unsupported.")
    if target.stat().st_size > MAX_BYTES:
        raise ValueError("The converted file exceeds the 10 MB download limit. Reduce or split the output.")
    if args.to == "xlsx":
        validate_office(target)
    else:
        try:
            from pypdf import PdfReader
            if not len(PdfReader(target).pages):
                raise ValueError("Empty PDF")
        except Exception:
            raise ValueError("Conversion produced an unreadable PDF. Check the input file and try again.") from None
    print(json.dumps({"ok": True, "path": str(target.relative_to(ROOT)), "bytes": target.stat().st_size}))


try:
    main()
except subprocess.TimeoutExpired:
    print(json.dumps({"ok": False, "message": "Conversion timed out. Try a smaller file or fewer pages/sheets."}))
    sys.exit(1)
except (ValueError, OSError, subprocess.CalledProcessError):
    error = sys.exc_info()[1]
    message = str(error) if isinstance(error, ValueError) else "Conversion failed. Check the input file and run /opt/portal/office-check."
    print(json.dumps({"ok": False, "message": message}))
    sys.exit(1)
