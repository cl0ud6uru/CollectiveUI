# ─────────────────────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/portal
# Production Docker Compose requires a unique password; it has no password fallback.
POSTGRES_PASSWORD=
# Public URL of the portal (used for OAuth callbacks and webhook URLs)
AUTH_URL=https://ai.corp.example.com
# openssl rand -base64 32
AUTH_SECRET=
# 32-byte base64 key for encrypting API keys, MCP headers and Graph tokens at rest: openssl rand -base64 32
ENCRYPTION_KEY=
# Key rotation (optional): add new keys as "<kid>:<base64>" pairs and point ENCRYPTION_PRIMARY_KID at the newest.
# ENCRYPTION_KEY stays readable as kid "k0"; the worker re-encrypts stored secrets under the primary key at start.
# ENCRYPTION_KEYS=k1:<openssl rand -base64 32>
# ENCRYPTION_PRIMARY_KID=k1
# Signs tool-approval requests so a browser can't forge an approval: openssl rand -base64 32
TOOL_APPROVAL_SECRET=
# Where uploaded files are stored (local disk / mounted volume). For `npm run dev`; docker-compose.yml ignores it and
# always uses its uploads volume (/data/uploads).
STORAGE_DIR=./data/uploads

# Directory admin role grants (semicolon-separated); these do not create accounts or credentials. Admins can also be granted via Admin → Groups / Users.
ADMIN_UPNS=
# Directory group identifiers: Entra group object IDs and/or LDAP DNs (lower-case), semicolon-separated
ADMIN_GROUPS=

# ─────────────────────────────────────────────────────────────────────────────
# Microsoft Entra ID (Azure AD) single sign-on
# ─────────────────────────────────────────────────────────────────────────────
AUTH_ENTRA_ENABLED=true
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# Extra delegated Graph scopes for the Microsoft 365 bot connector (optional)
# ENTRA_GRAPH_SCOPES=Mail.Read Mail.Send Calendars.Read Sites.Read.All Files.Read.All

# ─────────────────────────────────────────────────────────────────────────────
# On-prem Active Directory over LDAP(S)
# ─────────────────────────────────────────────────────────────────────────────
LDAP_ENABLED=false
LDAP_URL=ldaps://dc01.corp.example.com:636
LDAP_BIND_DN=CN=svc-aiportal,OU=Service Accounts,DC=corp,DC=example,DC=com
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=DC=corp,DC=example,DC=com
# LDAP_GROUP_BASE_DN=OU=Groups,DC=corp,DC=example,DC=com
# Default works for AD (sAMAccountName or UPN):
# LDAP_USER_FILTER=(&(objectClass=user)(|(sAMAccountName={{username}})(userPrincipalName={{username}})))
# Used to build a UPN when the directory entry has none
LDAP_UPN_SUFFIX=corp.example.com
# ad = nested groups via LDAP_MATCHING_RULE_IN_CHAIN (Active Directory), member = direct groupOfNames, memberOf = attribute
LDAP_GROUP_MODE=ad
# Path to your internal CA certificate for LDAPS
# LDAP_CA_CERT=/etc/ssl/certs/corp-root-ca.pem
LDAP_TLS_REJECT_UNAUTHORIZED=true

# ─────────────────────────────────────────────────────────────────────────────
# Workspaces (optional): per-person sandboxed containers bots can run commands in
# ─────────────────────────────────────────────────────────────────────────────
# Where web and worker reach sandboxd, and the secret they sign requests with (at least 32 bytes, shared with
# sandboxd). Leave both unset to run without workspaces. docker-compose.sandbox.yml sets SANDBOXD_URL itself.
# SANDBOXD_URL=http://127.0.0.1:4200
# SANDBOXD_SECRET=<openssl rand -base64 32>
# docker-compose.sandbox.yml only: the host's docker group id (getent group docker | cut -d: -f3), and whether
# sandboxd requires gVisor (runsc, the default), uses it when it works (auto), or never uses it (runc).
# DOCKER_GID=
# SANDBOXD_RUNTIME=runsc
# Capacity limits are sandboxd's own settings (SANDBOXD_MEMORY_MB, SANDBOXD_CPUS, SANDBOXD_PIDS, SANDBOXD_IDLE_MINUTES,
# SANDBOXD_MAX_RUNNING, SANDBOXD_MAX_EXECS, SANDBOXD_MAX_EXEC_SECONDS); see src/sandboxd/config.ts.
# How often the worker deletes workspaces of disabled people and leftover containers (cron, UTC).
# SANDBOX_CLEANUP_CRON=23 * * * *
# Bind the web port to one address (docker-compose.yml), e.g. 127.0.0.1 behind a reverse proxy on the same host.
# WEB_BIND=0.0.0.0

# ─────────────────────────────────────────────────────────────────────────────
# Worker and durable runs
# ─────────────────────────────────────────────────────────────────────────────
# Every chat reply runs in the worker (npm run worker; the `worker` service in docker-compose.yml), so chat needs it:
# without one, a reply fails after a minute with "The background worker didn't pick up this reply". Replies keep
# going when the browser closes, resume on reload and stop with Stop. The worker needs the same AUTH_SECRET,
# ENCRYPTION_KEY(S) and TOOL_APPROVAL_SECRET as the web app.
# Replies one worker process runs at once (each holds a few database connections while it streams).
# AGENT_RUN_CONCURRENCY=16
# Routines' first segments run on a queue of their own with this many slots per worker, so a burst of routines can't
# take the slots chat replies need (once someone answers a routine's approval, it continues on the chat queue).
# ROUTINE_RUN_CONCURRENCY=2
# Native asynchronous delegated tasks use their own worker queue. Waiting parents release their worker slots.
# TASK_RUN_CONCURRENCY=4
# Database pool per process (docker-compose.yml gives the worker WORKER_DATABASE_POOL_MAX, default 20, instead) and
# pg-boss's own pool in the worker.
# DATABASE_POOL_MAX=10
# WORKER_DATABASE_POOL_MAX=20
# JOBS_POOL_MAX=6
# Longest a chat reply may run before it's stopped (ms; routines use ROUTINE_TIMEOUT_MS below).
# RUN_TIMEOUT_MS=1800000
# Replies one person may have in progress at once (routines don't count).
# RUNS_PER_USER=3
# How often a running reply's worker checks in, and after how long without one the reply counts as interrupted (a
# worker's sweep, every RUN_SWEEP_MS, then saves what it had streamed and marks it interrupted).
# RUN_HEARTBEAT_MS=10000
# RUN_STALE_MS=60000
# RUN_SWEEP_MS=30000
# Hermes approvals: the worker keeps a paused Hermes run's event stream open for at most RUN_HOLD_MAX_MS and at most
# RUN_MAX_HELD of them (beyond that, a continuation re-attaches to Hermes from the saved state).
# RUN_HOLD_MAX_MS=3600000
# RUN_MAX_HELD=50

# ─────────────────────────────────────────────────────────────────────────────
# Optional tuning
# ─────────────────────────────────────────────────────────────────────────────
# Set to false if your OpenAI-compatible endpoints reject response_format=json_schema (OpenAI-compatible apps only)
# OPENAI_COMPAT_STRUCTURED_OUTPUTS=true
# Longest a routine's reply may run before it's stopped (ms)
# ROUTINE_TIMEOUT_MS=600000
# Sign in with ChatGPT (Admin → Settings): client version sent to the Codex models list
# CHATGPT_CLIENT_VERSION=0.156.1
# Dev/test only (ignored in production): point Sign in with ChatGPT at the mock server (npm run mock-llm)
# CHATGPT_AUTH_BASE_URL=http://localhost:4010
# CHATGPT_BACKEND_URL=http://localhost:4010/backend-api
# SCHEDULER_INTERVAL_MS=20000
# How often the worker re-lists MCP servers' tools to spot changes (cron, UTC).
# MCP_REFRESH_CRON=7 * * * *

# Model credentials are configured in Admin → Apps (and per user under Settings), never through vendor
# variables. Leave OPENAI_API_KEY, ANTHROPIC_API_KEY, AWS_*, GOOGLE_* etc. unset: the AI SDK would silently
# fall back to them. Web and worker log a warning at start if any are set.

# Standalone local accounts: explicitly opt in; no public signup or web bootstrap exists.
AUTH_LOCAL_ENABLED=false
# Local passkeys/TOTP: apply migration 0021 before this code. No account is enrolled automatically.
# AUTH_URL must be a stable HTTPS origin (http://localhost:<port> only for development).
# The RP ID is AUTH_URL's hostname; changing it requires planned passkey re-enrollment.
# TOTP requires ENCRYPTION_KEY / every ENCRYPTION_KEYS entry to contain a 32-byte base64 key,
# even in development. Preserve old key IDs when rotating. No dev encryption fallback is accepted.
# Password reset/recover-admin preserves MFA. See docs/security/local-mfa.md for lost-device recovery.
# Set AUTH_ENTRA_ENABLED=false and LDAP_ENABLED=false for a local-only installation.
# Operator CLI only, NEVER persist this flag in .env or the running services:
# LOCAL_AUTH_OPERATOR=bootstrap npm run local-account -- bootstrap
# LOCAL_AUTH_OPERATOR=recover-admin npm run local-account -- recover-admin
# See README for loading .env and using the worker image's interactive CLI.
# Default uses one shared source throttle bucket. Set true ONLY if your reverse proxy
# overwrites X-Real-IP with the client IP and the web port cannot be reached directly.
AUTH_TRUST_PROXY=false

# Native iOS app (ios/). Off by default. When true, people can sign the app in from the browser
# (any sign-in method) and approve the device; see docs/mobile.md. Tokens expire after
# MOBILE_SESSION_DAYS (1-365, default 30) and are revocable in Settings -> Security.
MOBILE_APP_ENABLED=false
# MOBILE_SESSION_DAYS=30

# Optional per-user Docker Hermes. Configure BOTH web and worker; no Docker socket here.
# Read docs/architecture/docker-hermes.md before enabling. Admin → Hermes grants per-user enrollment.
# DOCKER_HERMES_SOCKET=/run/collective-hermes/broker.sock
# Legacy DOCKER_HERMES_ALLOWED_USER_IDS is ignored by web/worker; use the explicit migration command.

# Personal allowance only. Disabled adapter: enabling this alone does not connect/authenticate Codex.
# Requires a separately authorized, isolated per-user app-server transport registered by the runtime broker.
CODEX_ALLOWANCE_BRIDGE_ENABLED=0
