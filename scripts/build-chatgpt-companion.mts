import { build } from 'esbuild';
import { mkdir, copyFile, writeFile, chmod } from 'node:fs/promises';
import { resolve, join } from 'node:path';
import { execFile } from 'node:child_process';
import { promisify } from 'node:util';
import { exactOrigin } from '../src/chatgpt-companion/client';
const exec = promisify(execFile);
const args = process.argv.slice(2);
if (args.length !== 2 || args[0] !== '--origin') throw new Error('Usage: build-chatgpt-companion --origin https://exact-installation-origin');
const origin = exactOrigin(args[1]);
const app = resolve('build/CollectiveUI ChatGPT.app'), contents = join(app, 'Contents'), resources = join(contents, 'Resources'), executable = join(contents, 'MacOS');
await mkdir(resources, { recursive: true }); await mkdir(executable, { recursive: true });
await build({ entryPoints: ['scripts/chatgpt-companion.mts'], outfile: join(resources, 'companion.mjs'), bundle: true, platform: 'node', format: 'esm', target: 'node22', sourcemap: false });
await copyFile(process.execPath, join(resources, 'node')); await chmod(join(resources, 'node'), 0o755);
await exec('/usr/bin/swiftc', ['companion/macos/Companion.swift', '-o', join(executable, 'CollectiveUIChatGPT'), '-framework', 'AppKit', '-module-cache-path', resolve('build/swift-module-cache')]);
await writeFile(join(resources, 'origins.json'), JSON.stringify([origin]));
await writeFile(join(contents, 'Info.plist'), `<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd"><plist version="1.0"><dict><key>CFBundleIdentifier</key><string>io.collectiveui.chatgpt-companion</string><key>CFBundleName</key><string>CollectiveUI ChatGPT</string><key>CFBundleExecutable</key><string>CollectiveUIChatGPT</string><key>CFBundlePackageType</key><string>APPL</string><key>CFBundleShortVersionString</key><string>0.1.0</string><key>CFBundleVersion</key><string>1</string><key>LSUIElement</key><true/><key>CFBundleURLTypes</key><array><dict><key>CFBundleURLName</key><string>CollectiveUI ChatGPT</string><key>CFBundleURLSchemes</key><array><string>collectiveui-chatgpt</string></array></dict></array></dict></plist>`);
await exec('/usr/bin/plutil', ['-lint', join(contents, 'Info.plist')]);
process.stdout.write(`Review bundle created at ${app}. Release signing and installation are separate.\n`);
