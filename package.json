{
  "name": "ai-portal",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch --env-file=.env.local src/worker/index.ts",
    "hermes:docker": "tsx src/docker-hermes/main.ts",
    "hermes:import-enrollment": "tsx scripts/migrate-docker-hermes-enrollment.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx --env-file=.env.local dev/seed.ts",
    "mock-llm": "node dev/mock-llm/server.mjs",
    "mcp-echo": "node dev/mcp-echo/server.mjs",
    "sandboxd": "node src/sandboxd/index.ts",
    "sandboxd:dev": "node --watch --env-file=.env.sandboxd src/sandboxd/index.ts",
    "sandbox:image": "scripts/build-sandbox-image.sh",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --project integration",
    "test:sandbox": "SANDBOX_DOCKER=1 vitest run --project sandbox",
    "local-account": "tsx scripts/local-account.ts",
    "test:hermes-ui": "node tests/browser/remote-hermes-workspace.mjs"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.94",
    "@ai-sdk/anthropic": "4.0.63",
    "@ai-sdk/azure": "4.0.79",
    "@ai-sdk/google-vertex": "5.0.93",
    "@ai-sdk/mcp": "2.0.57",
    "@ai-sdk/openai": "4.0.75",
    "@ai-sdk/openai-compatible": "3.0.55",
    "@ai-sdk/react": "4.0.116",
    "@collective/webauthn-browser": "npm:@simplewebauthn/browser@14.0.0",
    "@collective/webauthn-server": "npm:@simplewebauthn/server@14.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "ai": "7.0.113",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.1",
    "drizzle-orm": "^0.45.3",
    "esbuild": "0.28.2",
    "katex": "^0.18.9",
    "ldapts": "^9.2.0",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.12.3",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "otplib": "13.5.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.34.0",
    "qrcode": "1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "unpdf": "^1.8.1",
    "ws": "8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "katex": "$katex",
    "source-map-js": "1.2.2",
    "mammoth": {
      "argparse": "2.0.1"
    }
  },
  "engines": {
    "node": ">=22.18"
  }
