<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
    <array><dict>
        <key>CFBundleURLName</key><string>io.collectiveui.app</string>
        <key>CFBundleURLSchemes</key><array><string>collectiveui</string></array>
    </dict></array>
    <key>CollectiveLiveActivityPushEnabled</key><false/>
    <key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>CollectiveUI connects to the server address you enter, which may be on your local network.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Use your microphone to dictate a message when you tap the microphone button.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Turn your speech into a message draft. You choose when to send it.</string>
</dict>
</plist>
